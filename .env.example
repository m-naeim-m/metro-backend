# ===========================================
# Metro Backend Configuration
# ===========================================

# Server Port
PORT=8000

# Debug Mode (false in production)
DEBUG=false

# ===========================================
# SMS Configuration (Melipayamak)
# ===========================================
MELIPAYAMAK_BASE_URL=https://rest.payamak-panel.com
MELIPAYAMAK_USERNAME=your_username_here
MELIPAYAMAK_PASSWORD=your_password_here
MELIPAYAMAK_PATTERN=your_pattern_id_here

# ===========================================
# Admin Token (for admin endpoints)
# ===========================================
ADMIN_REPORT_TOKEN=your_strong_token_here

# ===========================================
# Map.ir API Keys (Multiple Keys Supported!)
# ===========================================
# Format: key1,key2,key3 (comma-separated)
# Each key gets 10,000 free requests per day
# Server automatically rotates between keys
# When one key reaches limit, switches to next
#
# Example with 3 keys:
# MAP_IR_API_KEYS=key1abc...,key2def...,key3ghi...
#
# To add more keys later, use admin endpoint:
# POST /admin/map-keys
# ===========================================
MAP_IR_API_KEYS=

# ===========================================
# Tapsell Configuration (Optional)
# ===========================================
TAPSELL_APP_ID=
TAPSELL_BANNER_ZONE_ID=
TAPSELL_INTERSTITIAL_ZONE_ID=
